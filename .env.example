# Which LLM to use: ollama (free, local) | groq (free tier) | gemini (free tier) | openai | anthropic
LLM_PROVIDER=ollama
# Leave empty to use the provider's default model. Only set this if you want a specific model.
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

LLM_CACHE=true
USE_MCP=true
# subprocess | docker
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=30
PER_TEST_TIMEOUT=5
SANDBOX_IMAGE=code-review-sandbox
# only if `node` is not on your PATH
NODE_BINARY=node
